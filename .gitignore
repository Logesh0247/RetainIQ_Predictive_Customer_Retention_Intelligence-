# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*

# User uploads
uploads/*

# Generated prediction reports (per-visitor artifacts created at runtime)
reports/private/
reports/runs/
reports/.cache_*.pkl
reports/.latest_run
reports/*.csv
# Keep the reports directory itself in the repo
!reports/.gitkeep

# Application logs (ignore contents, keep the folder placeholder)
logs/*
!logs/.gitkeep

# Editor / IDE
.vs/
.vscode/
.idea/

# Databases
*.sqlite
*.db

# OS files
desktop.ini
.DS_Store
Thumbs.db
